# ==========================================
# MuMuAINovel 配置文件示例
# ==========================================
# 复制此文件为 .env 并修改配置值
# cp .env.example .env

# ==========================================
# 应用配置
# ==========================================
APP_NAME=MuMuAINovel
APP_VERSION=1.5.7
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
TZ=Asia/Shanghai

# ==========================================
# SQLite 数据库配置
# ==========================================

# Docker Compose 固定使用 /app/data/mumu.db，并挂载到宿主机 ./data/。
# 本地源码运行从 backend/ 目录启动，可将下面一行放入 .env.local：
# DATABASE_URL=sqlite+aiosqlite:///./data/mumu-local.db

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ==========================================
# CORS 配置
# ==========================================
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# ==========================================
# 全局代理配置（可选，会影响遵循环境变量的网络请求）
# ==========================================
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# AI 服务配置（服务地址统一管理，写作密钥由管理员逐账号分配）
# ==========================================

# OpenAI 兼容接口配置：将下面两项替换为实际服务商的地址和密钥
# Base URL 填基础地址，不要填写 /chat/completions 完整路径
# 仅用于旧数据迁移给初始管理员；新账号不会继承此 Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 账号密钥加密主密钥（可选）。留空时自动在 backend/data/.ai_credentials.key 生成。
# 显式设置时使用 Fernet.generate_key()，必须固定保存并与数据库一起备份。
AI_CREDENTIAL_ENCRYPTION_KEY=

# Xiaomi MiMo 内置适配器（OpenAI 兼容格式）
# 注意：不要把真实 Key 提交到代码仓库；请只在本地 .env 或部署环境变量中配置
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_api_key_here
XIAOMI_MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 默认 AI 配置
DEFAULT_AI_PROVIDER=openai
# 默认模型先使用 gpt-6-sol；实际接口需要支持这个模型名称
DEFAULT_MODEL=gpt-6-sol
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=32000

# 本地 / Docker 内网 LLM（Ollama、llama.cpp、host.docker.internal）
# 默认关闭，保持 SSRF 防护。仅在本机或受信任网络部署时启用。
# ALLOW_PRIVATE_AI_ENDPOINTS=true
# ALLOWED_AI_HOSTS=host.docker.internal,127.0.0.1

# ==========================================
# LinuxDO OAuth 配置（可选）
# ==========================================
LINUXDO_CLIENT_ID=11111
LINUXDO_CLIENT_SECRET=11111
LINUXDO_REDIRECT_URI=http://localhost:8000/api/auth/callback
# LinuxDO 登录专用代理（可选，仅影响 OAuth token 与用户信息请求，不影响 AI/SMTP/其他请求）
# LINUXDO_PROXY_URL=http://127.0.0.1:7890
FRONTEND_URL=http://localhost:8000

# 初始管理员（LinuxDO user_id）
# INITIAL_ADMIN_LINUXDO_ID=your_linuxdo_user_id

# ==========================================
# 本地账户登录配置
# ==========================================
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin123
LOCAL_AUTH_DISPLAY_NAME=本地管理员

# ==========================================
# 会话配置
# ==========================================
SESSION_EXPIRE_MINUTES=120
SESSION_REFRESH_THRESHOLD_MINUTES=30
# 会话 Cookie 是否强制 Secure：Docker 默认通过 HTTP 访问；使用 HTTPS 时改为 true。
SESSION_COOKIE_SECURE=false

# ==========================================
# SMTP 默认配置（可在系统设置中被管理员覆盖）
# ==========================================
SMTP_PROVIDER=qq
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-qq-smtp-auth-code
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_FROM_NAME=MuMuAINovel
EMAIL_AUTH_ENABLED=true
EMAIL_REGISTER_ENABLED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60

# ==========================================
# 提示词工坊配置
# ==========================================
# 运行模式：client（本地部署）或 server（云端服务器）
# 只有 mumuverse.space:1566 需要设置为 server
WORKSHOP_MODE=client

# 云端服务地址（client 模式使用）
WORKSHOP_CLOUD_URL=https://mumuverse.space:1566

# 云端 API 请求超时时间（秒）
WORKSHOP_API_TIMEOUT=30
